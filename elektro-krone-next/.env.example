# kopie als .env.local anlegen und eintragen

# google maps: karte und anfahrt auf der kontaktseite
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# google search console: verifizierungs-code aus der search console
NEXT_PUBLIC_GSC_VERIFICATION=

# kontaktformular: endpunkt eines formular-dienstes (z.b. formspree), nimmt json per post entgegen
INQUIRY_WEBHOOK_URL=
